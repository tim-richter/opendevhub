{
  "name": "opendevhub",
  "version": "0.1.0",
  "description": "Local dashboard to orchestrate opencode v2 agents running in devcontainers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tim-richter/opendevhub.git",
    "directory": "apps/opendevhub"
  },
  "homepage": "https://github.com/tim-richter/opendevhub#readme",
  "bugs": {
    "url": "https://github.com/tim-richter/opendevhub/issues"
  },
  "type": "module",
  "bin": {
    "opendevhub": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/server/bin.ts --no-open",
    "dev:web": "vite",
    "build": "vite build && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "OPENDEVHUB_E2E=1 vitest run -c vitest.e2e.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@tanstack/charts": "1.0.0",
    "hono": "^4.13.13",
    "open": "^11.0.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pierre/diffs": "1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
