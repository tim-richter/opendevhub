{
  "name": "opendevhub",
  "version": "0.4.0",
  "description": "Local dashboard to orchestrate opencode v2 agents running in devcontainers",
  "homepage": "https://github.com/tim-richter/opendevhub#readme",
  "bugs": {
    "url": "https://github.com/tim-richter/opendevhub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tim-richter/opendevhub.git",
    "directory": "apps/opendevhub"
  },
  "bin": {
    "opendevhub": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "OPENDEVHUB_DEV=1 tsx src/server/bin.ts --no-open",
    "dev:web": "vite",
    "build": "vite build && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "OPENDEVHUB_E2E=1 vitest run -c vitest.e2e.config.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@napi-rs/keyring": "2.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/charts": "1.0.0",
    "cn": "0.4.0",
    "hono": "^4.13.13",
    "node-pty": "^1.1.0",
    "open": "^11.0.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@blazediff/react": "1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pierre/diffs": "1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "idb-keyval": "6.3.0",
    "lucide-react": "^1.52.0",
    "msw": "3.0.2",
    "msw-storybook-addon": "3.0.3",
    "playwright-core": "1.64.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.6.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
