{
  "name": "opendevhub-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter opendevhub dev",
    "dev:web": "pnpm --filter opendevhub dev:web",
    "dev:docs": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter opendevhub test",
    "test:e2e": "pnpm --filter opendevhub test:e2e"
  }
}
